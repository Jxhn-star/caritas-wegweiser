{
  "name": "caritas-wegweiser",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-17",
  "vars": {
    "ALLOWED_ORIGIN": "https://jxhn-star.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "durable_objects": {
    "bindings": [{ "name": "APPOINTMENT_STORE", "class_name": "AppointmentStore" }]
  },
  "migrations": [{ "tag": "appointments-v1", "new_sqlite_classes": ["AppointmentStore"] }],
  "ratelimits": [
    { "name": "DOCUMENT_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "APPOINTMENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false
}
