{
  "name": "caritas-document-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "vars": {
    "ALLOWED_ORIGIN": "https://jxhn-star.github.io",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [{
    "name": "DOCUMENT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 20, "period": 60 }
  }]
}
